NODE_ENV=development
PORT=5050

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/invoiceflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS (comma separated)
CORS_ORIGIN=http://localhost:5173

# Gemini AI (optional — enables natural-language invoice creation)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp bridge (optional — enables Send Reminder on the Ledger page).
# Point this at the self-hosted whatsapp-bridge workspace; see
# whatsapp-bridge/README.md for how to run it. Token must match the bridge's
# WHATSAPP_BRIDGE_TOKEN exactly.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
