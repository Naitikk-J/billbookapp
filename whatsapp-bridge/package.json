{
  "name": "@safarmate/whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp Web bridge for Safarmate Admin Portal. Runs whatsapp-web.js with persistent session, exposed over an HTTPS endpoint locked behind a shared secret.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
