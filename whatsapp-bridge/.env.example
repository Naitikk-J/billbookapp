# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_BRIDGE_TOKEN=

# Bind address. Default is loopback so only your machine can talk to it; set
# to 0.0.0.0 ONLY if you're going to terminate TLS in front (e.g. via a
# reverse proxy or Cloudflare tunnel).
HOST=127.0.0.1
PORT=5555

# Optional override for the LocalAuth data directory.
# WHATSAPP_SESSION_DIR=/absolute/path
