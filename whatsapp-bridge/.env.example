# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_BRIDGE_TOKEN=

# MongoDB Atlas connection string — REUSE the same cluster Safarmate already
# uses; we just need one small collection called `whatsapp_session` in the
# default database. Free-tier M0 is more than enough (session data ~1-5 MB).
MONGODB_URI=

# Optional overrides.
HOST=127.0.0.1
PORT=5555
# WHATSAPP_MONGO_COLLECTION=whatsapp_session
